<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PigeonPost.VpnClientView.ViewModels"
             x:Class="PigeonPost.VpnClientView.Views.AboutView"
             x:DataType="vm:AboutViewModel">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Text="About"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="16" />
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <TextBlock Text="{Binding ProductName}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Version, StringFormat='Version {0}'}"
                       FontSize="16"
                       Foreground="#888"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Description}"
                       FontSize="14"
                       Foreground="#AAA"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       MaxWidth="400" />
            <TextBlock Text="{Binding BuildDate, StringFormat='Build: {0}'}"
                       FontSize="12"
                       Foreground="#666"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
