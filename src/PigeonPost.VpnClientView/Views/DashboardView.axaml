<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PigeonPost.VpnClientView.ViewModels"
             x:Class="PigeonPost.VpnClientView.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto"
          ColumnDefinitions="*,*"
          Margin="24">
        <TextBlock Text="Dashboard"
                   FontSize="20"
                   FontWeight="Bold"
                   Grid.ColumnSpan="2"
                   Margin="0,0,0,16" />

        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button Content="Connect"
                            Command="{Binding ConnectCommand}"
                            IsVisible="{Binding CanConnect}" />
                    <Button Content="Disconnect"
                            Command="{Binding DisconnectCommand}"
                            IsVisible="{Binding CanDisconnect}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Grid.Column="0"
                    Spacing="8"
                    Margin="0,0,8,0">
            <TextBlock Text="Traffic"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*">
                <TextBlock Text="Bytes Sent:"
                           Grid.Row="0" />
                <TextBlock Text="{Binding BytesSentText}"
                           Grid.Row="0" Grid.Column="1"
                           Margin="8,0,0,0" />
                <TextBlock Text="Bytes Received:"
                           Grid.Row="1" />
                <TextBlock Text="{Binding BytesReceivedText}"
                           Grid.Row="1" Grid.Column="1"
                           Margin="8,0,0,0" />
                <TextBlock Text="Up Speed:"
                           Grid.Row="2" />
                <TextBlock Text="{Binding SpeedUpText}"
                           Grid.Row="2" Grid.Column="1"
                           Margin="8,0,0,0" />
                <TextBlock Text="Down Speed:"
                           Grid.Row="3" />
                <TextBlock Text="{Binding SpeedDownText}"
                           Grid.Row="3" Grid.Column="1"
                           Margin="8,0,0,0" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Grid.Column="1"
                    Spacing="8"
                    Margin="8,0,0,0">
            <TextBlock Text="Session"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*">
                <TextBlock Text="Uptime:"
                           Grid.Row="0" />
                <TextBlock Text="{Binding UptimeText}"
                           Grid.Row="0" Grid.Column="1"
                           Margin="8,0,0,0" />
                <TextBlock Text="Reconnects:"
                           Grid.Row="1" />
                <TextBlock Text="{Binding ReconnectCount}"
                           Grid.Row="1" Grid.Column="1"
                           Margin="8,0,0,0" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
