<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PigeonPost.VpnClientView.ViewModels"
             xmlns:controls="using:PigeonPost.VpnClientView.Controls"
             x:Class="PigeonPost.VpnClientView.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
          ColumnDefinitions="*,*"
          Margin="24">
        <TextBlock Text="Dashboard"
                   FontSize="20"
                   FontWeight="Bold"
                   Grid.ColumnSpan="2"
                   Margin="0,0,0,16" />

        <Border Grid.Row="1"
                Grid.ColumnSpan="2"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Fill="{Binding StatusBadgeColor}"
                             Width="12"
                             Height="12"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Connected means transport/session established with server."
                           FontSize="11"
                           Foreground="#888"
                           TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Button Content="Connect"
                            Command="{Binding ConnectCommand}"
                            IsVisible="{Binding CanConnect}"
                            AutomationProperties.Name="Connect" />
                    <Button Content="Disconnect"
                            Command="{Binding DisconnectCommand}"
                            IsVisible="{Binding CanDisconnect}"
                            AutomationProperties.Name="Disconnect" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12"
                BorderThickness="1"
                BorderBrush="#333">
            <StackPanel Spacing="4">
                <TextBlock Text="Android VPN Interface"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding VpnInterfaceStatusText}"
                           FontSize="12" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3"
                    Grid.Column="0"
                    Spacing="8"
                    Margin="0,0,8,0">
            <TextBlock Text="Traffic"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*">
                <TextBlock Text="Bytes Sent:"
                           Grid.Row="0" />
                <TextBlock Text="{Binding BytesSentText}"
                           Grid.Row="0" Grid.Column="1"
                           Margin="8,0,0,0" />
                <TextBlock Text="Bytes Received:"
                           Grid.Row="1" />
                <TextBlock Text="{Binding BytesReceivedText}"
                           Grid.Row="1" Grid.Column="1"
                           Margin="8,0,0,0" />
                <TextBlock Text="Up Speed:"
                           Grid.Row="2" />
                <TextBlock Text="{Binding SpeedUpText}"
                           Grid.Row="2" Grid.Column="1"
                           Margin="8,0,0,0" />
                <TextBlock Text="Down Speed:"
                           Grid.Row="3" />
                <TextBlock Text="{Binding SpeedDownText}"
                           Grid.Row="3" Grid.Column="1"
                           Margin="8,0,0,0" />
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    Grid.Column="1"
                    Spacing="8"
                    Margin="8,0,0,0">
            <TextBlock Text="Session"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*">
                <TextBlock Text="Uptime:"
                           Grid.Row="0" />
                <TextBlock Text="{Binding UptimeText}"
                           Grid.Row="0" Grid.Column="1"
                           Margin="8,0,0,0" />
                <TextBlock Text="Reconnects:"
                           Grid.Row="1" />
                <TextBlock Text="{Binding ReconnectCount}"
                           Grid.Row="1" Grid.Column="1"
                           Margin="8,0,0,0" />
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Grid.ColumnSpan="2"
                   Text="Speed (last 30 seconds)"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Margin="0,8,0,4" />

        <Border Grid.Row="5"
                Grid.ColumnSpan="2"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="#333"
                Padding="4"
                Margin="0,0,0,16">
            <controls:SpeedChart SentData="{Binding SentHistory}"
                                 ReceivedData="{Binding ReceivedHistory}" />
        </Border>
    </Grid>
</UserControl>
