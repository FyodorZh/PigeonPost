<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PigeonPost.VpnClientView.ViewModels"
             xmlns:vpn="using:PigeonPost.Vpn"
             x:Class="PigeonPost.VpnClientView.Views.LogsView"
             x:DataType="vm:LogsViewModel">
    <Grid RowDefinitions="Auto,*"
          Margin="24">
        <TextBlock Text="Application Logs"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,16" />

        <ListBox ItemsSource="{Binding Logs}"
                 Grid.Row="1"
                 BorderThickness="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vpn:VpnLogEntry">
                    <Grid ColumnDefinitions="Auto,Auto,*"
                          Margin="0,2">
                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                   FontFamily="Consolas, monospace"
                                   FontSize="12" />
                        <Border Grid.Column="1"
                                CornerRadius="4"
                                Padding="4,0"
                                Margin="8,0"
                                Opacity="0.7">
                            <TextBlock Text="{Binding Level}"
                                       FontSize="11" />
                        </Border>
                        <TextBlock Text="{Binding Message}"
                                   Grid.Column="2"
                                   TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
