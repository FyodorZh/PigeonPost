<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PigeonPost.VpnClientView.ViewModels"
             xmlns:vpn="using:PigeonPost.Vpn"
             xmlns:controls="using:PigeonPost.VpnClientView.Controls"
             x:Class="PigeonPost.VpnClientView.Views.LogsView"
             x:DataType="vm:LogsViewModel">
    <UserControl.Resources>
        <controls:LogLevelToBackgroundConverter x:Key="LogLevelToBackground" />
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,*,Auto"
          Margin="24">
        <TextBlock Text="Application Logs"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Text="Log levels: Info (white) | Warning (yellow) | Error (red)"
                   FontSize="11"
                   Foreground="#888"
                   Margin="0,0,0,8" />

        <ListBox x:Name="LogList"
                 ItemsSource="{Binding Logs}"
                 Grid.Row="2"
                 BorderThickness="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vpn:VpnLogEntry">
                    <Grid ColumnDefinitions="Auto,Auto,*"
                          Margin="0,2">
                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                                   FontFamily="Consolas, monospace"
                                   FontSize="12"
                                   Foreground="#AAA" />
                        <Border Grid.Column="1"
                                CornerRadius="4"
                                Padding="4,0"
                                Margin="8,0"
                                Background="{Binding Level, Converter={StaticResource LogLevelToBackground}}"
                                Opacity="0.9">
                            <TextBlock Text="{Binding Level}"
                                       FontSize="11"
                                       Foreground="White"
                                       FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding Message}"
                                   Grid.Column="2"
                                   TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="3"
                   Text="Verbosity: all events are recorded. Info = normal, Warning = potential issues, Error = failures."
                   FontSize="11"
                   Foreground="#888"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
