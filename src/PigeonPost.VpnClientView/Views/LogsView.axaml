<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PigeonPost.VpnClientView.ViewModels"
             x:Class="PigeonPost.VpnClientView.Views.LogsView"
             x:DataType="vm:MainViewModel">
    <Grid RowDefinitions="Auto,*">
        <TextBlock Text="Logs"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="16" />
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Text="Application logs will appear here."
                       FontSize="14"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
